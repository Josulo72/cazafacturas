# Copia este archivo a .env y rellena SOLO las claves que quieras usar.
# Las claves nunca salen de esta máquina ni se suben al repositorio.

# Motor CLI (no necesita clave: usa la sesión ya autenticada del terminal)
# Si ambos están instalados, se usa el primero con `MOTOR_CLI_DEFAULT`.
MOTOR_CLI_DEFAULT=claude
# OPCIONES: claude | codex

# Motor por API (opcional)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Motor local (opcional)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava